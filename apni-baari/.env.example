# ---------------------------------------------------------------------------
# Apni BAARI — WhatsApp farmer slot-booking system (SIH26032)
# Copy this file to .env and fill in real values before deploying.
# NEVER commit a real .env file (it is already covered by .gitignore).
# ---------------------------------------------------------------------------

# Which environment this is running as. Controls two things:
#  - "production" disables the /dev/* local WhatsApp test harness routes.
#  - has no effect on OTP_MODE below; set that separately.
APP_ENV=development

# --- WhatsApp Business Cloud API (Meta) -------------------------------------
# From your Meta App Dashboard > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose yourself — you'll enter this same value in the Meta
# App Dashboard webhook configuration screen. It's how /webhook's GET
# verification step proves the request really came from your Meta app setup.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_GRAPH_API_VERSION=v20.0

# --- OTP ---------------------------------------------------------------------
# development: OTP is printed to the server console (and surfaced in the
#              browser-based /dev simulator) instead of sent as a real SMS.
# production:  requires a real SMS provider to be wired in (see
#              backend/otp_service.py: get_sms_provider()) — the app will
#              refuse to silently fake OTP delivery in production.
OTP_MODE=development
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=5
# Change this in production — it salts the OTP hash stored in the database.
OTP_HASH_SALT=change-me-in-production

# --- SMS provider (only read when OTP_MODE=production) ----------------------
# Pick one and implement/enable the matching branch in
# backend/otp_service.py: get_sms_provider(). Left blank until you choose a
# provider — see README "OTP setup" section.
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# --- App -----------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
